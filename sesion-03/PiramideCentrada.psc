Algoritmo PiramideCentrada
	Definir n, fila, j Como Entero
	Escribir "Ingrese la altura de la piramide"
	Leer n
	
	
	Para fila<-1 Hasta n Hacer
		Para j<-1 Hasta n-i
			Hacer
				Escribir " "
				Leer 
			Hasta Que 
		FinPara
		Para j<-1 Hasta 2*i-1
			Hacer
				Escribir "*"
			FinPara
			
			Hasta Que 
		FinPara
	FinPara
FinAlgoritmo
